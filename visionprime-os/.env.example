# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- API app ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml postgres service) ---
POSTGRES_USER=visionprime
POSTGRES_PASSWORD=changeme
POSTGRES_DB=visionprime
DATABASE_URL=postgresql://visionprime:changeme@localhost:5432/visionprime

# --- Redis (matches docker-compose.yml redis service) ---
REDIS_URL=redis://localhost:6379

# --- Admin / Club apps ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
