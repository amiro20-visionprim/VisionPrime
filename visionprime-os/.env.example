# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

# --- API app ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database (matches docker-compose.yml postgres service) ---
POSTGRES_USER=visionprime
POSTGRES_PASSWORD=changeme
POSTGRES_DB=visionprime
DATABASE_URL=postgresql://visionprime:changeme@localhost:5432/visionprime

# --- Redis (matches docker-compose.yml redis service) ---
REDIS_URL=redis://localhost:6379

# --- Auth (Phase 03) — generate real random values, never commit real secrets ---
JWT_ACCESS_SECRET=changeme-access-secret-please-rotate
JWT_REFRESH_SECRET=changeme-refresh-secret-please-rotate
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- WordPress/WooCommerce integration (Phase 04) — generate a real random value, never commit a real secret ---
INTEGRATION_ENCRYPTION_KEY=changeme-32-char-minimum-encryption-key

# --- Initial super admin seed (used only by `npm run seed`, never read at runtime) ---
SEED_SUPER_ADMIN_EMAIL=owner@example.com
SEED_SUPER_ADMIN_PASSWORD=changeme-strong-password
SEED_SUPER_ADMIN_NAME=Super Admin

# --- Admin / Club apps ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
